{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.community_teardown",
    "title": "Teardown a community conversation",
    "description": "Scan recent Hacker News discussions around your category and deliver a ranked opportunity ledger - content topics, positioning phrases, product signals and who to help first - each item grounded in verbatim comment evidence.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "buyer_context": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000,
          "title": "Category and buyers",
          "description": "Who the product is for, the category it competes in, and the problem these builders are trying to solve.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 10
          }
        },
        "query": {
          "type": "string",
          "maxLength": 240,
          "default": "",
          "title": "Exact search",
          "description": "Optional single Hacker News search phrase. Leave empty to derive one to four searches from the category context.",
          "x-tin-ui": {
            "control": "text",
            "order": 20
          }
        },
        "competitor": {
          "type": "string",
          "maxLength": 200,
          "default": "",
          "title": "Competitor to scan",
          "description": "Optional product, company or author name to also search for direct mentions of.",
          "x-tin-ui": {
            "control": "text",
            "order": 30
          }
        },
        "window_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 730,
          "default": 365,
          "title": "Look back (days)",
          "x-tin-ui": {
            "control": "counter",
            "order": 40
          }
        }
      },
      "required": [
        "project_id",
        "buyer_context"
      ]
    },
    "integration_requirements": [
      {
        "provider_key": "custom.api.hackernews",
        "capabilities": [
          "http.read"
        ],
        "required": true
      }
    ],
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/community-teardown/SKILL.md",
        "skills/community-teardown/RANKING.md"
      ],
      "entry_skill": "community-teardown",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "services": {
        "hn": {
          "provider_key": "custom.api.hackernews",
          "max_calls": 8,
          "max_response_bytes": 64000
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/COMMUNITY_TEARDOWN.md",
        "media_type": "text/markdown",
        "max_bytes": 64000
      }
    }
  }
}