{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "research.interview_digest",
    "title": "Synthesize customer interviews",
    "description": "Extract observations from interview notes, cluster into themes, and generate an evidence-backed digest with insights and prioritized recommendations.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "interviews": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 50, "maxLength": 2000},
          "title": "Interview notes or transcripts"
        },
        "research_objective": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "title": "Research objective",
          "description": "What this research aimed to learn."
        },
        "participant_context": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "default": "",
          "title": "Participant context",
          "description": "Optional context about participants (roles, segments, experience level)."
        }
      },
      "required": ["project_id", "interviews", "research_objective"]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "model_routes": {
        "extract": {
          "provider": "openai",
          "model": "gpt-5.6-luna",
          "max_calls": 1,
          "max_input_bytes": 24000,
          "max_output_tokens": 2048
        },
        "synthesize": {
          "provider": "openai",
          "model": "gpt-5.6-luna",
          "max_calls": 1,
          "max_input_bytes": 24000,
          "max_output_tokens": 2048
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "research/INTERVIEW_DIGEST.md",
        "media_type": "text/markdown",
        "max_bytes": 50000
      }
    }
  }
}
